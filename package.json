{
  "name": "solidworks-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "MCP server for SolidWorks automation with a Windows .NET COM worker.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run clean:dist && npm run build:worker && tsc -p tsconfig.json",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:worker": "dotnet build workers/SolidWorksComWorker/SolidWorksComWorker.csproj",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker:status": "node scripts/worker-status.mjs",
    "validate:tools": "node scripts/validate-tools.mjs",
    "handshake:mcp": "node scripts/mcp-handshake.mjs",
    "check:registry": "node scripts/check-registry.mjs && node scripts/check-no-marengo.mjs && node scripts/check-selection-bindings.mjs && node scripts/check-schemas.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "sync:worker-ts": "node scripts/sync-worker-ts.mjs",
    "docs:generate": "node scripts/generate-manifest-from-registry.mjs && node scripts/sync-worker-ts.mjs && node scripts/generate-api-catalog.mjs && node scripts/generate-error-catalog.mjs && node scripts/scrape-sw-api-help.mjs && tsx scripts/generate-tool-docs.ts",
    "docs:check": "node scripts/generate-manifest-from-registry.mjs --check && tsx scripts/generate-tool-docs.ts --check",
    "docs:scrape:tavily": "bash scripts/scrape-api-docs-tavily.sh",
    "docs:scrape:brightdata": "node scripts/scrape-api-docs-brightdata.mjs",
    "docs:import:chm": "node scripts/import-chm-api-docs.mjs && node scripts/normalize-api-docs.mjs",
    "docs:normalize": "node scripts/normalize-api-docs.mjs",
    "docs:signatures": "node scripts/generate-api-signatures.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  }
}
