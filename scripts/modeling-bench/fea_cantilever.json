{
  "name": "fea_cantilever",
  "description": "FEA validation against beam theory: 100x10x10 mm steel cantilever, 100 N tip load. delta = FL^3/3EI = 0.200 mm; root bending stress = 60 MPa (FEA peak is higher at the fixed corners). Also a normal-pressure case and a PLA material case.",
  "expect": { "volume_mm3": 10000, "bodies": 1 },
  "steps": [
    { "tool": "solidworks_sketch", "args": { "path": "$PART", "on": "Right Plane", "name": "Section", "entities": [{ "type": "center_rectangle", "center": [0, 0], "width": 10, "height": 10 }] } },
    { "tool": "solidworks_extrude", "args": { "path": "$PART", "sketch": "Section", "depth": 100, "name": "Beam" }, "expect": { "volume": 10000 } },
    { "tool": "solidworks_simulate_static", "args": {
      "path": "$PART", "material": "STEEL",
      "fixtures": [{ "faces": { "face": { "near": [0, 0, 0], "normal": [-1, 0, 0] } } }],
      "loads": [{ "faces": { "face": { "near": [100, 0, 0], "normal": [1, 0, 0] } }, "value_n": 100, "direction": [0, -1, 0] }]
    }, "expect": { "fields": {
      "results.maxDisplacementMm": { "approx": 0.2, "tol": 0.06 },
      "results.maxVonMisesMPa": { "min": 50, "max": 110 },
      "results.factorOfSafety": { "min": 3, "max": 7.5 }
    } } },
    { "tool": "solidworks_simulate_static", "args": {
      "path": "$PART", "material": "PLA",
      "fixtures": [{ "faces": { "face": { "near": [0, 0, 0], "normal": [-1, 0, 0] } } }],
      "loads": [{ "faces": { "face": { "near": [100, 0, 0], "normal": [1, 0, 0] } }, "value_n": 10, "direction": [0, -1, 0] }]
    }, "expect": { "fields": { "results.maxDisplacementMm": { "approx": 1.1429, "tol": 0.06 } } } },
    { "tool": "solidworks_simulate_static", "args": {
      "path": "$PART", "material": "6061-T6",
      "fixtures": [{ "faces": { "face": { "near": [0, 0, 0], "normal": [-1, 0, 0] } } }],
      "loads": [{ "type": "pressure", "faces": { "face": { "near": [50, 5, 0], "normal": [0, 1, 0] } }, "value_mpa": 0.1 }]
    }, "expect": { "fields": { "results.maxDisplacementMm": { "approx": 0.2177, "tol": 0.08 } } } }
  ]
}
