{
  "name": "cov_sketch",
  "description": "Ellipse, 3-point arc, clockwise arc, spline, point, construction geometry; region counting; multi-region extrude into separate bodies; negative selector test",
  "expect": { "volume_mm3": 4712.39, "bodies": 3 },
  "steps": [
    { "tool": "solidworks_sketch", "args": { "path": "$PART", "on": "Front Plane", "name": "Shapes", "entities": [
      { "type": "ellipse", "center": [0, 0], "major_radius": 20, "minor_radius": 10 },
      { "type": "arc3", "start": [30, 0], "mid": [40, 10], "end": [50, 0] },
      { "type": "line", "from": [50, 0], "to": [30, 0] },
      { "type": "arc", "center": [0, 40], "start": [10, 40], "end": [-10, 40], "clockwise": true },
      { "type": "line", "from": [-10, 40], "to": [10, 40] },
      { "type": "circle", "center": [0, 0], "radius": 30, "construction": true },
      { "type": "point", "at": [0, 0] }
    ] }, "expect": { "regions": 3 } },
    { "tool": "solidworks_extrude", "args": { "path": "$PART", "sketch": "Shapes", "depth": 5, "name": "Shapes3" }, "expect": { "volume": 4712.39, "bodies": 3 } },
    { "tool": "solidworks_sketch", "args": { "path": "$PART", "on": "Top Plane", "name": "Curves", "entities": [
      { "type": "spline", "points": [[0, 0], [10, 5], [20, -5], [30, 0]] },
      { "type": "centerline", "from": [0, -10], "to": [30, -10] }
    ] }, "expect": { "regions": 0, "fields": { "segmentCount": 2 } } },
    { "tool": "solidworks_sketch", "args": { "path": "$PART", "on": { "face": { "near": [500, 500, 500] } }, "name": "Nowhere", "entities": [{ "type": "point", "at": [0, 0] }] }, "expect_error": "FACE_NOT_FOUND" }
  ]
}
